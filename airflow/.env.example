# Ejemplo de configuración de variables de entorno
# Este archivo es solo una plantilla. El archivo .env real se genera automáticamente
# ejecutando ./init_airflow.sh

# UID del usuario de Airflow (se configura automáticamente según el OS)
# Linux: 1000
# macOS: UID del usuario actual (ej: 501, 502, etc.)
AIRFLOW_UID=
